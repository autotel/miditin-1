# Writes OUT, the source behind Source/Model/BuildInfo.h: the commit and the build time. Run on
# every build (`cmake -P`), but the file is only rewritten when its content changes, so a no-op
# build within the same minute stays a no-op.
execute_process(COMMAND git rev-parse --short HEAD
    WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE rc ERROR_QUIET)
if(NOT rc EQUAL 0 OR sha STREQUAL "")
    set(sha "unknown")
else()
    execute_process(COMMAND git status --porcelain --untracked-files=no
        WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE changes ERROR_QUIET)
    if(NOT changes STREQUAL "")
        string(APPEND sha "-dirty")
    endif()
endif()
string(TIMESTAMP date "%Y-%m-%d %H:%M")

set(content "// Generated by cmake/BuildInfo.cmake on every build. Do not edit.
#include \"Model/BuildInfo.h\"

const char* mdt::buildSha()  { return \"${sha}\"; }
const char* mdt::buildDate() { return \"${date}\"; }
")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
